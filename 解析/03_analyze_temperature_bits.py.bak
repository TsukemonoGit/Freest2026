from __future__ import annotations

import argparse
import csv
import re
import sys
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable


DEFAULT_EXPECTED_BITS = 424
BITS_PER_GROUP = 8


@dataclass(frozen=True)
class Capture:
    order: int
    path: Path
    label: str
    temperature: float | None
    bits: str
    groups: tuple[str, ...]


def natural_sort_key(path: Path) -> list[object]:
    parts = re.split(r"(\d+)", path.name)
    return [int(part) if part.isdigit() else part.casefold() for part in parts]


def collect_input_files(inputs: Iterable[str]) -> list[Path]:
    files: list[Path] = []

    for raw_input in inputs:
        path = Path(raw_input).expanduser()

        if not path.exists():
            raise FileNotFoundError(f"入力が見つかりません: {path}")

        if path.is_dir():
            directory_files = sorted(path.glob("*.txt"), key=natural_sort_key)
            if not directory_files:
                raise FileNotFoundError(f"TXTファイルがありません: {path}")
            files.extend(directory_files)
        elif path.is_file():
            files.append(path)
        else:
            raise ValueError(f"通常のファイルまたはディレクトリではありません: {path}")

    unique_files: list[Path] = []
    seen: set[Path] = set()

    for path in files:
        resolved = path.resolve()
        if resolved not in seen:
            seen.add(resolved)
            unique_files.append(path)

    if len(unique_files) < 2:
        raise ValueError("比較には2個以上の入力ファイルが必要です。")

    return unique_files


def extract_bits(text: str, source: Path) -> str:
    candidates: list[str] = []

    whole_text_without_spaces = re.sub(r"\s+", "", text)
    if (
        len(whole_text_without_spaces) >= BITS_PER_GROUP
        and set(whole_text_without_spaces) <= {"0", "1"}
    ):
        candidates.append(whole_text_without_spaces)

    for line in text.splitlines():
        stripped_line = line.strip()
        if not stripped_line:
            continue

        line_without_spaces = re.sub(r"\s+", "", stripped_line)
        if (
            len(line_without_spaces) >= BITS_PER_GROUP
            and set(line_without_spaces) <= {"0", "1"}
        ):
            candidates.append(line_without_spaces)

        if ":" in stripped_line or "：" in stripped_line:
            tail = re.split(r"[:：]", stripped_line, maxsplit=1)[1]
            tail_without_spaces = re.sub(r"\s+", "", tail)
            if (
                len(tail_without_spaces) >= BITS_PER_GROUP
                and set(tail_without_spaces) <= {"0", "1"}
            ):
                candidates.append(tail_without_spaces)

        candidates.extend(re.findall(r"[01]{8,}", stripped_line))

    if not candidates:
        raise ValueError(f"0/1ビット列を読み取れませんでした: {source}")

    return max(candidates, key=len)


def parse_temperature_from_name(path: Path) -> float | None:
    match = re.search(r"(?<!\d)(-?\d+(?:\.\d+)?)\s*(?:℃|度)", path.stem)
    if match is None:
        return None
    return float(match.group(1))


def format_number(value: float) -> str:
    if value.is_integer():
        return str(int(value))
    return f"{value:g}"


def split_into_groups(bits: str) -> tuple[str, ...]:
    return tuple(
        bits[index : index + BITS_PER_GROUP]
        for index in range(0, len(bits), BITS_PER_GROUP)
    )


def load_captures(
    paths: list[Path],
    expected_bits: int,
    supplied_temperatures: list[float] | None,
) -> list[Capture]:
    if supplied_temperatures is not None and len(supplied_temperatures) != len(paths):
        raise ValueError(
            "--temperatures の個数は、読み込むファイル数と同じにしてください。"
        )

    captures: list[Capture] = []

    for order, path in enumerate(paths, start=1):
        text = path.read_text(encoding="utf-8-sig")
        bits = extract_bits(text, path)

        if expected_bits > 0 and len(bits) != expected_bits:
            raise ValueError(
                f"ビット数が想定と異なります: {path.name} "
                f"({len(bits)}ビット、想定{expected_bits}ビット)"
            )

        if len(bits) % BITS_PER_GROUP != 0:
            raise ValueError(
                f"ビット数が8で割り切れません: {path.name} ({len(bits)}ビット)"
            )

        temperature = (
            supplied_temperatures[order - 1]
            if supplied_temperatures is not None
            else parse_temperature_from_name(path)
        )

        captures.append(
            Capture(
                order=order,
                path=path,
                label=path.stem,
                temperature=temperature,
                bits=bits,
                groups=split_into_groups(bits),
            )
        )

    bit_lengths = {len(capture.bits) for capture in captures}
    if len(bit_lengths) != 1:
        details = ", ".join(
            f"{capture.path.name}={len(capture.bits)}"
            for capture in captures
        )
        raise ValueError(f"ファイル間でビット数が一致しません: {details}")

    return captures


def msb_value(group: str) -> int:
    return int(group, 2)


def lsb_value(group: str) -> int:
    return int(group[::-1], 2)


def bcd_value(value: int) -> int | None:
    tens = (value >> 4) & 0x0F
    ones = value & 0x0F
    if tens > 9 or ones > 9:
        return None
    return tens * 10 + ones


def changed_group_indexes(captures: list[Capture]) -> list[int]:
    group_count = len(captures[0].groups)
    return [
        index
        for index in range(group_count)
        if len({capture.groups[index] for capture in captures}) > 1
    ]


def changed_bit_indexes(first: Capture, second: Capture) -> list[int]:
    return [
        index
        for index, (left, right) in enumerate(zip(first.bits, second.bits))
        if left != right
    ]


def format_group_positions(indexes: Iterable[int]) -> str:
    values = [str(index + 1) for index in indexes]
    return ", ".join(values) if values else "なし"


def print_input_summary(captures: list[Capture]) -> None:
    print("【入力データ】")
    print("順番\t温度\tビット数\t8ビット組数\tファイル")

    for capture in captures:
        temperature = (
            f"{format_number(capture.temperature)}℃"
            if capture.temperature is not None
            else "不明"
        )
        print(
            f"{capture.order}\t{temperature}\t{len(capture.bits)}\t"
            f"{len(capture.groups)}\t{capture.path.name}"
        )


def print_adjacent_differences(captures: list[Capture]) -> None:
    print("\n【隣り合う測定結果の差】")

    for previous, current in zip(captures, captures[1:]):
        bit_indexes = changed_bit_indexes(previous, current)
        group_indexes = sorted({index // BITS_PER_GROUP for index in bit_indexes})

        print(f"\n{previous.label}  →  {current.label}")
        print(f"変化したビット数: {len(bit_indexes)}")
        print(f"変化した8ビット組: {format_group_positions(group_indexes)}")

        if not bit_indexes:
            print("変化したビット位置: なし")
            continue

        print("8ビット組\t組内位置\t全体位置\t変化")
        for bit_index in bit_indexes:
            group_index = bit_index // BITS_PER_GROUP
            position_in_group = bit_index % BITS_PER_GROUP
            print(
                f"{group_index + 1}\t{position_in_group + 1}\t{bit_index + 1}\t"
                f"{previous.bits[bit_index]}→{current.bits[bit_index]}"
            )


def print_changed_group_values(
    captures: list[Capture], changed_indexes: list[int]
) -> None:
    print("\n【全測定で変化した8ビット組】")
    print(f"位置: {format_group_positions(changed_indexes)}")

    for group_index in changed_indexes:
        print(f"\n--- 8ビット組 {group_index + 1} ---")
        print(
            "順番\t温度\t受信順8ビット\t"
            "MSB十進\tMSB十六進\tLSB十進\tLSB十六進\tファイル"
        )

        for capture in captures:
            group = capture.groups[group_index]
            msb = msb_value(group)
            lsb = lsb_value(group)
            temperature = (
                f"{format_number(capture.temperature)}℃"
                if capture.temperature is not None
                else "不明"
            )
            print(
                f"{capture.order}\t{temperature}\t{group}\t"
                f"{msb}\t0x{msb:02X}\t{lsb}\t0x{lsb:02X}\t"
                f"{capture.path.name}"
            )


def values_by_temperature(
    captures: list[Capture], group_index: int, bit_order: str
) -> dict[float, set[int]]:
    result: dict[float, set[int]] = defaultdict(set)

    for capture in captures:
        if capture.temperature is None:
            continue
        group = capture.groups[group_index]
        value = msb_value(group) if bit_order == "MSB" else lsb_value(group)
        result[capture.temperature].add(value)

    return dict(result)


def format_offset(offset: float) -> str:
    if abs(offset) < 1e-9:
        return "温度そのもの"
    if offset > 0:
        return f"温度＋{format_number(offset)}"
    return f"温度－{format_number(abs(offset))}"


def detect_linear_rule(points: list[tuple[float, int]]) -> str | None:
    if len(points) < 2:
        return None

    first_temperature, first_value = points[0]
    second_temperature = None
    second_value = None

    for temperature, value in points[1:]:
        if abs(temperature - first_temperature) > 1e-9:
            second_temperature = temperature
            second_value = value
            break

    if second_temperature is None or second_value is None:
        return None

    slope = (second_value - first_value) / (second_temperature - first_temperature)
    intercept = first_value - slope * first_temperature

    for temperature, value in points:
        predicted = slope * temperature + intercept
        if abs(predicted - value) > 1e-9:
            return None

    if abs(slope - 1.0) < 1e-9:
        return format_offset(intercept)

    return (
        f"値＝{format_number(slope)}×温度"
        f"{('＋' if intercept >= 0 else '－')}"
        f"{format_number(abs(intercept))}"
    )


def candidate_rules(
    captures: list[Capture], group_index: int, bit_order: str
) -> list[str]:
    grouped_values = values_by_temperature(captures, group_index, bit_order)

    if len(grouped_values) < 2:
        return ["温度情報が不足しているため判定できない"]

    duplicate_temperature_values = {
        temperature: values
        for temperature, values in grouped_values.items()
        if len(values) > 1
    }
    if duplicate_temperature_values:
        details = ", ".join(
            f"{format_number(temperature)}℃={sorted(values)}"
            for temperature, values in sorted(duplicate_temperature_values.items())
        )
        return [f"同じ温度で値が一致しない ({details})"]

    points = sorted(
        (temperature, next(iter(values)))
        for temperature, values in grouped_values.items()
    )
    rules: list[str] = []

    linear_rule = detect_linear_rule(points)
    if linear_rule is not None:
        rules.append(linear_rule)

    decoded_bcd: list[tuple[float, int]] = []
    for temperature, value in points:
        decoded = bcd_value(value)
        if decoded is None:
            decoded_bcd = []
            break
        decoded_bcd.append((temperature, decoded))

    if decoded_bcd and all(
        abs(temperature - decoded) < 1e-9
        for temperature, decoded in decoded_bcd
    ):
        rules.append("BCDで温度そのもの")

    if not rules:
        rules.append("単純な数値規則とは一致しない")

    return rules


def print_temperature_candidates(
    captures: list[Capture], changed_indexes: list[int]
) -> None:
    known_temperature_count = sum(
        capture.temperature is not None for capture in captures
    )

    print("\n【温度の表し方の候補】")
    if known_temperature_count != len(captures):
        print(
            "温度を読み取れないファイルがあります。"
            "ファイル名に『28度』または『28℃』を含めるか、"
            "--temperatures を指定してください。"
        )

    if known_temperature_count < 2:
        print("温度が分かる測定が2個未満のため、候補判定はできません。")
        return

    for group_index in changed_indexes:
        print(f"\n8ビット組 {group_index + 1}")
        for bit_order in ("MSB", "LSB"):
            rules = candidate_rules(captures, group_index, bit_order)
            print(f"  {bit_order}: {' / '.join(rules)}")


def print_same_temperature_comparison(captures: list[Capture]) -> None:
    grouped_captures: dict[float, list[Capture]] = defaultdict(list)
    for capture in captures:
        if capture.temperature is not None:
            grouped_captures[capture.temperature].append(capture)

    duplicate_groups = {
        temperature: items
        for temperature, items in grouped_captures.items()
        if len(items) > 1
    }

    print("\n【同じ温度へ上げ下げ両方で到達した結果】")
    if not duplicate_groups:
        print("同じ温度の測定が複数ないため、比較できません。")
        return

    for temperature, items in sorted(duplicate_groups.items()):
        different_group_indexes = [
            index
            for index in range(len(items[0].groups))
            if len({capture.groups[index] for capture in items}) > 1
        ]
        labels = ", ".join(capture.label for capture in items)
        print(f"{format_number(temperature)}℃: {labels}")
        print(
            "  異なる8ビット組: "
            f"{format_group_positions(different_group_indexes)}"
        )
        if not different_group_indexes:
            print("  0/1列は一致")


def write_csv(
    output_path: Path,
    captures: list[Capture],
    changed_indexes: list[int],
) -> None:
    output_path.parent.mkdir(parents=True, exist_ok=True)

    with output_path.open("w", encoding="utf-8-sig", newline="") as csv_file:
        writer = csv.writer(csv_file)
        writer.writerow(
            [
                "測定順",
                "操作名",
                "入力ファイル",
                "温度",
                "8ビット組位置",
                "受信順8ビット",
                "MSB十進数",
                "MSB十六進数",
                "LSB十進数",
                "LSB十六進数",
            ]
        )

        for capture in captures:
            for group_index in changed_indexes:
                group = capture.groups[group_index]
                msb = msb_value(group)
                lsb = lsb_value(group)
                writer.writerow(
                    [
                        capture.order,
                        capture.label,
                        str(capture.path),
                        ""
                        if capture.temperature is None
                        else format_number(capture.temperature),
                        group_index + 1,
                        group,
                        msb,
                        f"0x{msb:02X}",
                        lsb,
                        f"0x{lsb:02X}",
                    ]
                )


def build_argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "0/1変換済みの赤外線信号を比較し、"
            "温度変更で変化した8ビット位置を調べます。"
        )
    )
    parser.add_argument(
        "inputs",
        nargs="+",
        help=(
            "比較するTXTファイル、またはTXTファイルを入れたディレクトリ。"
            "複数ファイルを指定した場合は指定順で比較します。"
        ),
    )
    parser.add_argument(
        "--expected-bits",
        type=int,
        default=DEFAULT_EXPECTED_BITS,
        help=(
            "想定するビット数。既定値は424。"
            "ビット数の確認を無効にする場合は0。"
        ),
    )
    parser.add_argument(
        "--temperatures",
        type=float,
        nargs="+",
        help=(
            "各入力ファイルの温度を入力順に指定します。"
            "省略時はファイル名の『28度』『28℃』などから読み取ります。"
        ),
    )
    parser.add_argument(
        "--csv",
        type=Path,
        help="変化した8ビット組の一覧をCSVにも保存します。",
    )
    return parser


def main() -> int:
    parser = build_argument_parser()
    args = parser.parse_args()

    try:
        paths = collect_input_files(args.inputs)
        captures = load_captures(
            paths=paths,
            expected_bits=args.expected_bits,
            supplied_temperatures=args.temperatures,
        )
    except (OSError, UnicodeError, ValueError) as error:
        print(f"エラー: {error}", file=sys.stderr)
        return 1

    changed_indexes = changed_group_indexes(captures)

    print_input_summary(captures)
    print_adjacent_differences(captures)
    print_changed_group_values(captures, changed_indexes)
    print_temperature_candidates(captures, changed_indexes)
    print_same_temperature_comparison(captures)

    if args.csv is not None:
        try:
            write_csv(args.csv, captures, changed_indexes)
        except OSError as error:
            print(f"CSV保存エラー: {error}", file=sys.stderr)
            return 1
        print(f"\nCSV保存先: {args.csv.resolve()}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())